# PostgreSQL connection string for the replacement platform
DATABASE_URL=postgresql://user:password@localhost:5432/haavocato
# Set true only when your managed PostgreSQL service requires verified TLS
PGSSL=false

# Server
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Use a cryptographically random secret of at least 32 bytes in production.
# Generate locally; never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=262144

# Private object storage and email delivery will be configured in a later implementation stage.
# Do not add live credentials to this file or commit a populated .env file.
