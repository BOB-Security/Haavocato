# PostgreSQL connection string; required for storing consultation requests
DATABASE_URL=postgresql://user:password@localhost:5432/haavocato
# Set true only when PostgreSQL requires TLS and your provider requires it
PGSSL=false
# Optional port; Azure App Service provides PORT automatically
PORT=3000
# Set to the canonical public origin in production, e.g. https://example.com
PUBLIC_ORIGIN=http://localhost:3000
